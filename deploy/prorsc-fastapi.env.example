# Variáveis de produção. Copie para /etc/prorsc-fastapi.env (dono root, grupo prorsc, chmod 640).
# Gere cada segredo com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GERE-UM-SEGREDO
JWT_TTL_MINUTOS=480
HASHIDS_SALT=GERE-UM-SALT
DATABASE_URL=sqlite+aiosqlite:////var/lib/prorsc-fastapi/prorsc.db
# Front e API no mesmo domínio (via Apache): CORS só é necessário em desenvolvimento.
CORS_ORIGINS=https://calculadora.exemplo.com.br
# Usados no build do frontend (deploy/atualizar.sh). O navegador chama a API no mesmo domínio.
# Na raiz do domínio:  FRONT_PUBLIC_PATH=/                 FRONT_API_URL=/api/v1
# Em subpasta:         FRONT_PUBLIC_PATH=/prorsc_fastapi/   FRONT_API_URL=/prorsc_fastapi/api/v1
FRONT_PUBLIC_PATH=/
FRONT_API_URL=/api/v1
# Só em subpasta: prefixo público da aplicação (corrige o Swagger em /prorsc_fastapi/api/docs).
ROOT_PATH=
GUNICORN_BIND=127.0.0.1:8002
GUNICORN_WORKERS=2
